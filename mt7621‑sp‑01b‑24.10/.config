CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y

# 固件文件系统压缩
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=64k
CONFIG_TARGET_SQUASHFS_COMP_XZ=y

# 关闭内核调试，节省空间
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_KASAN=n
CONFIG_KERNEL_DEBUG_FS=n
CONFIG_KERNEL_PRINTK=n

# MT7621无线驱动 RE‑SP‑01B MT7603+MT7615
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y

# eMMC板载存储支持 必须开启
CONFIG_PACKAGE_kmod-mmc-mt7621=y
CONFIG_PACKAGE_kmod-mmc=y

# USB驱动
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y

# 文件系统 eMMC用
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y

# Breed兼容，不擦除bootloader
CONFIG_TARGET_PREINIT_DISABLE_FAILSAFE=n
CONFIG_PACKAGE_bootcount=y

# 关闭OLED相关（本机无屏幕）
# CONFIG_PACKAGE_luci-app-oled is not set
# CONFIG_PACKAGE_lcdsimple is not set

# Luci语言，仅中英，省空间
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_en=y
# CONFIG_LUCI_LANG_zh_Hant is not set
# CONFIG_LUCI_LANG_fr is not set
# CONFIG_LUCI_LANG_de is not set
# CONFIG_LUCI_LANG_ru is not set

# iStoreOS核心商店
CONFIG_PACKAGE_luci-app-store=y
# 磁盘管理，管理eMMC
CONFIG_PACKAGE_luci-app-diskman=y
# OpenAppFilter应用过滤
CONFIG_PACKAGE_luci-app-oaf=y
# NAS套件
CONFIG_PACKAGE_luci-app-nas=y

# luci必备兼容依赖（重要，插件运行必须）
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y

# 基础luci组件
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-network=y

# 监控、测速工具
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y

# 基础网络
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_iptables=y

# 块设备工具
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y

# SSH
CONFIG_PACKAGE_openssh-sftp-server=y

# 裁剪多余模块
CONFIG_PACKAGE_kmod-irqbalance=n

# 关闭其他平台target，防止误编译
# CONFIG_TARGET_x86_64 is not set
# CONFIG_TARGET_rockchip is not set
# CONFIG_TARGET_ramips_mt7620 is not set
# CONFIG_TARGET_ramips_mt7628 is not set


